# Backend API base URL (without trailing slash and without /api suffix; /api is appended per endpoint)
# Web (same machine): http://localhost:8080
# Physical phone (Expo Go): use your computer's local Wi-Fi IP, e.g. http://192.168.1.42:8080
# Note: localhost does NOT work from a physical phone on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://localhost:8080
